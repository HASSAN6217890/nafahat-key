<?xml version="1.0" encoding="utf-8"?>
<!-- v0.5: HTTPS only, system certificate authorities only (no user-added CAs), no cleartext anywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
